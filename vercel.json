{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/ai-fly-guide", "destination": "/trip-planner", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/trout",
      "destination": "/index.html"
    },
    {
      "source": "/stocking",
      "destination": "/index.html"
    },
    {
      "source": "/plan",
      "destination": "/index.html"
    },
    {
      "source": "/picker",
      "destination": "/index.html"
    },
    { "source": "/fly-picker", "destination": "/api/page?kind=flypicker" },
    { "source": "/trip-planner", "destination": "/api/page?kind=tripplanner" },
    { "source": "/river-report-tool", "destination": "/api/page?kind=rivertool" },
    { "source": "/for-shops", "destination": "/api/page?kind=forshops" },
    { "source": "/clubs", "destination": "/api/page?kind=clubs" },
    { "source": "/rivers", "destination": "/api/page?kind=rivers" },
    { "source": "/rivers/:key", "destination": "/api/page?kind=river&key=:key" },
    { "source": "/shops", "destination": "/api/page?kind=shops" },
    { "source": "/shops/:slug", "destination": "/api/page?kind=shop&slug=:slug" },
    { "source": "/forum", "destination": "/api/page?kind=forum" },
    { "source": "/forum/c/:key", "destination": "/api/page?kind=forumcat&key=:key" },
    { "source": "/forum/t/:key", "destination": "/api/page?kind=forumthread&key=:key" },
    { "source": "/guides", "destination": "/api/page?kind=guides" },
    { "source": "/guides/:slug", "destination": "/api/page?kind=guide&slug=:slug" },
    { "source": "/grouse", "destination": "/grouse/index.html" },
    { "source": "/dove-fields", "destination": "/api/page?kind=dove" },
    { "source": "/dove-fields/:slug", "destination": "/api/page?kind=dovefield&slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/page?kind=sitemap" },
    { "source": "/robots.txt", "destination": "/api/page?kind=robots" },
    { "source": "/llms.txt", "destination": "/api/page?kind=llms" },
    { "source": "/photos/:id", "destination": "/api/shops?photo=:id" }
  ],
  "functions": {
    "api/plan.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/shops.js": {
      "includeFiles": "data/flypicker.json"
    },
    "api/forum.js": {
      "includeFiles": "data/*.json"
    },
    "api/page.js": {
      "includeFiles": "data/*.json"
    },
    "api/rivers.js": {
      "includeFiles": "data/flypicker.json"
    }
  },
  "crons": [
    {
      "path": "/api/health",
      "schedule": "17 11 * * *"
    }
  ]
}
